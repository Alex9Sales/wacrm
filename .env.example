# ==================================================================
# CRM Fluxia — variáveis de ambiente
#
# Este é o alvo da stack pós-migração (Postgres puro + Better Auth +
# Redis + MinIO + multi-provider). Durante a transição, o app ainda
# pode exigir as variáveis Supabase legadas (.env.local.example);
# elas morrem na Fase 3.
#
# Dev local: os valores default abaixo casam com docker-compose.dev.yml.
# ==================================================================

# ------------------------------------------------------------------
# Banco de dados (Postgres 16 + pgvector)
# ------------------------------------------------------------------
DATABASE_URL=postgres://crmfluxia:crmfluxia_dev@localhost:5432/crmfluxia

# ------------------------------------------------------------------
# Redis (filas BullMQ do broadcast + pub/sub do SSE + rate limit)
# ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# Better Auth
# ------------------------------------------------------------------
# Segredo de sessão. Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=generate-a-long-random-string
# URL pública do app (sem barra no final)
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------
# Criptografia de credenciais (canais WhatsApp, chaves de IA)
# 64 hex chars = 32 bytes, AES-256-GCM. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA troque depois de conectar canais — os tokens salvos ficam ilegíveis.
# ------------------------------------------------------------------
ENCRYPTION_KEY=your-64-char-hex-key-here

# ------------------------------------------------------------------
# Storage S3 (MinIO em dev; MinIO/S3/R2 em produção)
# ------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=crmfluxia
S3_SECRET_KEY=crmfluxia_dev
S3_BUCKET_AVATARS=avatars
S3_BUCKET_MEDIA=media
S3_REGION=us-east-1
# "true" para MinIO/self-hosted (path-style); "false" para AWS S3 real
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------
# Provider: Meta WhatsApp Cloud API (oficial)
# App Secret verifica o HMAC de todo webhook inbound (fail-closed).
# ------------------------------------------------------------------
META_APP_SECRET=your-meta-app-secret
# Necessário só para templates com header de imagem (resumable upload)
# META_APP_ID=your-meta-app-id

# ------------------------------------------------------------------
# Provider: WAHA (não-oficial, QR pairing)
# URL e API key da instância WAHA. Em dev: docker-compose.dev.yml
# sobe em localhost:3001 com a key abaixo.
# ------------------------------------------------------------------
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=waha_dev_key

# ------------------------------------------------------------------
# URL canônica pública do deploy (sitemap, OG, links gerados por
# worker/cron sem request de origem). Sem barra no final.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==================================================================
# OPCIONAIS
# ==================================================================

# E-mail transacional (reset de senha, convites) — decidir na Fase 2
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=CRM Fluxia <no-reply@fluxia.com.br>

# Segredo do cron de automações (Wait steps). Gere: openssl rand -hex 32
# AUTOMATION_CRON_SECRET=

# Pula chamadas reais à Meta ao submeter templates (dev/CI)
# WHATSAPP_TEMPLATES_DRY_RUN=true

# Worker de broadcast: "true" simula o envio (dev/CI/staging), "false" (ou
# ausente) envia de verdade. Em produção mantenha false.
# BROADCAST_DRY_RUN=false

# Assistente de IA (bring-your-own-key por conta; nada obrigatório aqui)
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20

# URL pública p/ montar links de mídia.
#
# RECOMENDADO (produção): aponte para o PROXY de mídia do próprio app,
# servido por GET /api/files/:bucket/*key sobre HTTPS. O MinIO responde em
# HTTP puro; uma <img>/<audio> com src http numa página https é BLOQUEADA
# pelo navegador (mixed content) → ícone quebrado / player morto. Servir a
# mídia pelo domínio https do app elimina o bloqueio (e o Meta também
# consegue baixar a mídia por esta URL https).
#
#   S3_PUBLIC_URL=https://<seu-dominio>/api/files
#
# Em dev, aponte para o app local (o proxy roda em localhost:3000):
S3_PUBLIC_URL=http://localhost:3000/api/files

# ── Fase 8: super-admin (operador SaaS da Fluxia) ──
# Allowlist de e-mails com acesso ao painel /admin (platform admin).
# Separados por vírgula, case-insensitive. Fora dessa lista → 403.
# PLATFORM_ADMIN_EMAILS=alex@fluxia.com.br,ops@fluxia.com.br
#
# (Opcional) Canal WhatsApp da PRÓPRIA Fluxia usado para disparar os
# lembretes de cobrança do /admin (POST .../reminder). É o id de um
# registro em `channels` pertencente à org da Fluxia. Sem isso, o botão
# "Enviar lembrete" retorna 400 pedindo para configurar.
# PLATFORM_BILLING_CHANNEL_ID=
